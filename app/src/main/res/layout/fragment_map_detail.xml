<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background">

    <!-- Top bar ala iOS navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ Maps"
            android:textColor="@color/ios_blue"
            android:textSize="17sp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView android:id="@+id/mapDetailTitle" style="@style/IosLargeTitle" android:text="Map" android:paddingBottom="4dp" />
            <TextView android:id="@+id/mapDetailSubtitle" style="@style/IosCaption" android:text="-" android:paddingBottom="16dp" />

            <!-- Aksi utama: 2 kolom -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <Button android:id="@+id/readButton" style="@style/IosButtonPrimary" android:text="Baca" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="6dp" />
                <Button android:id="@+id/writeButton" style="@style/IosButtonDestructive" android:text="Tulis ke ECU" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
                <Button android:id="@+id/exportButton" style="@style/IosButtonPrimary" android:backgroundTint="#8E8E93" android:text="Export" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="6dp" />
                <Button android:id="@+id/importButton" style="@style/IosButtonPrimary" android:backgroundTint="#8E8E93" android:text="Import" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Pattern section -->
            <TextView style="@style/IosSectionHeader" android:text="Pattern (koreksi persen massal)" android:paddingBottom="6dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_ios_card"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/patternPercentInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="mis. -5 atau +10"
                    android:inputType="numberSigned|numberDecimal"
                    android:background="@android:color/transparent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textColor="@color/ios_label_secondary" />

                <Button
                    android:id="@+id/applyPatternButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terapkan"
                    android:textColor="@color/ios_blue"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <TextView android:id="@+id/mapReadStatus" style="@style/IosCaption" android:text="" android:paddingBottom="8dp" />

            <!-- Easy Setting: cuma dipakai/ditampilkan buat Fuel Map. Set batas RPM tiap
                 level (Low/Mid/High) + nilai tambahan per level, diterapkan ke SEMUA
                 baris TPS sekaligus untuk kolom RPM yang masuk rentang itu. -->
            <LinearLayout
                android:id="@+id/easySettingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <TextView style="@style/IosSectionHeader" android:text="Easy Setting (RPM Low / Mid / High)" android:paddingBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_ios_card"
                    android:padding="12dp">

                    <!-- Header kolom -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Min RPM" style="@style/IosCaption" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Max RPM" style="@style/IosCaption" android:gravity="center" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Nilai +/-" style="@style/IosCaption" android:gravity="center" />
                    </LinearLayout>

                    <!-- Baris Low -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Low" android:textColor="@color/ios_green" android:textStyle="bold" />
                        <EditText android:id="@+id/lowMinInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="1000" android:inputType="number" android:gravity="center" android:background="@drawable/bg_ios_inset" android:layout_marginEnd="4dp" />
                        <EditText android:id="@+id/lowMaxInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="4250" android:inputType="number" android:gravity="center" android:background="@drawable/bg_ios_inset" android:layout_marginEnd="4dp" />
                        <EditText android:id="@+id/lowValueInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="0" android:inputType="numberSigned|numberDecimal" android:gravity="center" android:background="@drawable/bg_ios_inset" />
                    </LinearLayout>

                    <!-- Baris Mid -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="6dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Mid" android:textColor="@color/ios_orange" android:textStyle="bold" />
                        <EditText android:id="@+id/midMinInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="4500" android:inputType="number" android:gravity="center" android:background="@drawable/bg_ios_inset" android:layout_marginEnd="4dp" />
                        <EditText android:id="@+id/midMaxInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="8250" android:inputType="number" android:gravity="center" android:background="@drawable/bg_ios_inset" android:layout_marginEnd="4dp" />
                        <EditText android:id="@+id/midValueInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="0" android:inputType="numberSigned|numberDecimal" android:gravity="center" android:background="@drawable/bg_ios_inset" />
                    </LinearLayout>

                    <!-- Baris High -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="High" android:textColor="@color/ios_red" android:textStyle="bold" />
                        <EditText android:id="@+id/highMinInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="8500" android:inputType="number" android:gravity="center" android:background="@drawable/bg_ios_inset" android:layout_marginEnd="4dp" />
                        <EditText android:id="@+id/highMaxInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="16000" android:inputType="number" android:gravity="center" android:background="@drawable/bg_ios_inset" android:layout_marginEnd="4dp" />
                        <EditText android:id="@+id/highValueInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="0" android:inputType="numberSigned|numberDecimal" android:gravity="center" android:background="@drawable/bg_ios_inset" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/applyEasySettingButton"
                        style="@style/IosButtonPrimary"
                        android:text="Terapkan Easy Setting ke Semua Baris TPS" />
                </LinearLayout>
            </LinearLayout>

            <!-- Editor sel: tap 1/beberapa sel di tabel buat pilih, lalu Set/+/- di sini -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ios_card"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/selectedCellLabel"
                    style="@style/IosCaption"
                    android:text="Belum ada sel dipilih — tap sel di tabel, atau tap label TPS buat pilih 1 baris" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/cellValueInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="nilai"
                        android:inputType="numberSigned|numberDecimal"
                        android:background="@drawable/bg_ios_inset"
                        android:padding="8dp" />

                    <Button android:id="@+id/setValueButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Set" android:textColor="@color/ios_blue" android:background="@android:color/transparent" />
                    <Button android:id="@+id/addValueButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textColor="@color/ios_green" android:background="@android:color/transparent" />
                    <Button android:id="@+id/subValueButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="−" android:textColor="@color/ios_red" android:background="@android:color/transparent" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ios_card"
                android:padding="4dp">

                <TextView
                    android:id="@+id/mapPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:textColor="@color/ios_label_secondary"
                    android:text="Belum ada data. Tap 'Baca' dulu." />

                <!-- Grid dengan header beku: baris atas (RPM) + kolom kiri (TPS/Load) diam,
                     cuma area data yang scroll. Sel data EDITABLE (EditText), tap-ketik langsung. -->
                <LinearLayout
                    android:id="@+id/mapGridContainer"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Baris 1: pojok + header RPM (scroll horizontal, sinkron dgn data) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/mapCorner"
                            android:layout_width="64dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="TPS\RPM"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:background="#F2F2F7"
                            android:textColor="@color/ios_label_secondary" />

                        <HorizontalScrollView
                            android:id="@+id/mapHeaderHScroll"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:scrollbars="none">
                            <LinearLayout
                                android:id="@+id/mapHeaderRow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <!-- Baris 2: kolom TPS (scroll vertical, sinkron) + grid data (scroll 2 arah) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ScrollView
                            android:id="@+id/mapTpsVScroll"
                            android:layout_width="64dp"
                            android:layout_height="match_parent"
                            android:scrollbars="none">
                            <LinearLayout
                                android:id="@+id/mapTpsColumn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </ScrollView>

                        <ScrollView
                            android:id="@+id/mapDataVScroll"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:scrollbars="none">
                            <HorizontalScrollView
                                android:id="@+id/mapDataHScroll"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:scrollbars="none">
                                <LinearLayout
                                    android:id="@+id/mapDataGrid"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />
                            </HorizontalScrollView>
                        </ScrollView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
