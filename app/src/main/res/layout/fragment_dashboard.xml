<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <TextView style="@style/IosLargeTitle" android:text="Dashboard" android:paddingBottom="4dp" />
    <TextView style="@style/IosCaption" android:text="Live data dari ECU" android:paddingBottom="16dp" />

    <!-- RPM + Speed berdampingan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_ios_card"
            android:padding="16dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/rpmValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/ios_label" />
            <TextView style="@style/IosCaption" android:text="RPM" android:paddingBottom="10dp" />

            <ProgressBar
                android:id="@+id/rpmGauge"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="12000"
                android:progress="0"
                android:progressTint="@color/ios_blue"
                android:progressBackgroundTint="@color/ios_separator" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_ios_card"
            android:padding="16dp"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/speedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/ios_green" />
            <TextView style="@style/IosCaption" android:text="KM/H (GPS)" android:paddingBottom="10dp" />

            <TextView
                android:id="@+id/gpsStatusText"
                style="@style/IosCaption"
                android:text="Mencari sinyal GPS..."
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/identityText"
        style="@style/IosCaption"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:text="ECU: -" />

    <!-- Grid stat: 2 kolom pakai LinearLayout biasa -->
    <LinearLayout
        android:id="@+id/statGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/startLiveButton"
        style="@style/IosButtonPrimary"
        android:text="Mulai Live Stream"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/pollLiveButton"
        style="@style/IosButtonDestructive"
        android:text="Berhenti Stream"
        android:layout_marginBottom="20dp" />

    <TextView style="@style/IosSectionHeader" android:text="Developer — Raw Data" android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_ios_card"
        android:padding="12dp">

        <ScrollView android:id="@+id/rawLogScroll" android:layout_width="match_parent" android:layout_height="160dp">
            <TextView
                android:id="@+id/rawLogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:textColor="#3A3A3C"
                android:text="(belum ada data masuk)" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/rawCommandInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ios_inset"
                android:padding="10dp"
                android:hint="Command manual, mis. 160A" />

            <Button
                android:id="@+id/sendRawButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Kirim"
                android:textColor="@color/ios_blue"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
</ScrollView>
